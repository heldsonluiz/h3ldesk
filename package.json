{
  "name": "h3ldesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts prisma *.ts *.mjs package.json",
    "format:check": "prettier --check src tests scripts prisma *.ts *.mjs package.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:test": "node scripts/with-test-env.mjs prisma migrate deploy",
    "test:serve": "node scripts/with-test-env.mjs next start --hostname 127.0.0.1 --port 3101",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "better-auth": "1.7.14",
    "@better-auth/prisma-adapter": "1.7.14",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "^8.16.3",
    "zod": "^4.1.0",
    "react-hook-form": "^7.0.0",
    "@hookform/resolvers": "^5.0.0",
    "lucide-react": "^1.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "@radix-ui/react-slot": "^1.2.3",
    "nodemailer": "^7.0.0",
    "dotenv": "^17.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.0.0",
    "@types/nodemailer": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.64.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@next/eslint-plugin-next": "16.4.3",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.72.0"
  }
}

# Somente desenvolvimento/testes locais. Nunca reutilizar senhas de produção.
# Copie para .env.docker e substitua os dois valores por senhas locais diferentes.
H3LDESK_DEV_DB_PASSWORD=substitua_por_uma_senha_local_de_desenvolvimento
H3LDESK_TEST_DB_PASSWORD=substitua_por_outra_senha_local_de_testes
